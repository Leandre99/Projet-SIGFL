# =========================================================================
# Copy this file to ".env" and adjust values. ".env" is gitignored.
# Consumed by:
#   - spring-dotenv  -> resolves ${...} in application*.yml when running locally
#   - docker compose -> fills service settings and the app environment
#
# The defaults below match the docker-compose stack, so `docker compose up`
# then running the app locally (dev profile) works out of the box.
# =========================================================================

# --- Active Spring profile ---
SPRING_PROFILES_ACTIVE=dev

# --- HTTP server ---
SERVER_PORT=8080

# --- Datasource (Spring app) ---
DB_URL=jdbc:postgresql://localhost:5432/sigfl
DB_USERNAME=sigfl
DB_PASSWORD=sigfl

# --- PostgreSQL container ---
POSTGRES_DB=sigfl
POSTGRES_USER=sigfl
POSTGRES_PASSWORD=sigfl
POSTGRES_PORT=5432

# =========================================================================
# Auth — Keycloak
# =========================================================================
KEYCLOAK_REALM=sigfl
# Issuer the app validates tokens against (host:port as seen from the app).
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/sigfl
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =========================================================================
# Storage — switch provider here: s3 (MinIO / AWS / any S3) or local
# =========================================================================
STORAGE_PROVIDER=s3
# S3 / MinIO settings (used when STORAGE_PROVIDER=s3)
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_BUCKET=sigfl
STORAGE_S3_PATH_STYLE=true
# Local filesystem settings (used when STORAGE_PROVIDER=local)
STORAGE_LOCAL_PATH=./data/storage
# MinIO container credentials/ports
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Upload limits ---
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=15MB

# =========================================================================
# Mail — switch provider here: smtp (MailDev / real SMTP) or log
# =========================================================================
MAIL_PROVIDER=smtp
MAIL_FROM=no-reply@sigfl.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
# MailDev web inbox / SMTP ports
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
